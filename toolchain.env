# Single source of truth for the proving toolchain. Everything that compiles
# a circuit or derives a verification key — scripts/build.sh, both GitHub
# workflows, and any consumer regenerating a Solidity verifier — reads the
# pins from here. Release artifacts are built by EXACTLY these versions;
# bumping either pin means re-cutting a release and rolling the downstream
# verifiers together with it (see README "Toolchain").
#
# Install with:
#   noirup --version "$NARGO_VERSION"
#   bbup   --version "$BB_VERSION"
NARGO_VERSION=1.0.0-beta.25
BB_VERSION=5.2.0
