#[test]
fn id_x_0() {
    // "2244994945"
    let raw: [u8; 20] = [
        0x32, 0x32, 0x34, 0x34, 0x39, 0x39, 0x34, 0x39, 0x34, 0x35, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00,
    ];
    crate::check_id(raw, 10, ID_RULES_X);
    let node = crate::tagged_hash::<15, 20, 35>(USER_ID_TAG_X, raw, 10);
    assert(
        node
            == [
                0x68, 0x29, 0x18, 0x69, 0x97, 0x6f, 0xfa, 0xd2, 0xab, 0xf3, 0xe9, 0x33, 0xec, 0x9a,
                0xb2, 0x62, 0x33, 0x95, 0xff, 0x8b, 0x3b, 0x92, 0x42, 0xe6, 0x55, 0xe1, 0xda, 0x3e,
                0xf4, 0x3d, 0x4f, 0x94,
            ],
    );
}

