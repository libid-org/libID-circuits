        0x36, 0x37, 0x38, 0x39, 0x30,
    ];
    crate::check_id(raw, 20, ID_RULES_X);
    let node = crate::tagged_hash::<15, 20, 35>(USER_ID_TAG_X, raw, 20);
    assert(
        node
            == [
                0x46, 0xd7, 0x87, 0xdc, 0x85, 0x12, 0x7e, 0x79, 0xb2, 0x48, 0xe3, 0x76, 0x8a, 0xb6,
                0x57, 0xf0, 0xc5, 0x43, 0xbc, 0x3c, 0xe5, 0xb9, 0x7f, 0x16, 0x45, 0xc6, 0x9f, 0x84,
                0x32, 0xa3, 0xec, 0x3b,
            ],
    );
}

