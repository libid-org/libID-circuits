#[test]
fn id_google_14() {
    // "110169484474386276334"
    let raw: [u8; 31] = [
        0x31, 0x31, 0x30, 0x31, 0x36, 0x39, 0x34, 0x38, 0x34, 0x34, 0x37, 0x34, 0x33, 0x38, 0x36,
        0x32, 0x37, 0x36, 0x33, 0x33, 0x34, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00,
    ];
    crate::check_id(raw, 21, ID_RULES_GOOGLE);
    let node = crate::tagged_hash::<20, 31, 51>(USER_ID_TAG_GOOGLE, raw, 21);
    assert(
        node
            == [
                0x62, 0x08, 0x66, 0xcf, 0xb4, 0xd2, 0x77, 0x6a, 0x32, 0xcd, 0x94, 0xd8, 0xe8, 0xb5,
                0x55, 0x77, 0x52, 0x6a, 0xf8, 0x61, 0x15, 0xeb, 0xf1, 0x25, 0xd4, 0xca, 0x1c, 0xa7,
                0xbf, 0x07, 0x73, 0x7e,
            ],
    );
}

