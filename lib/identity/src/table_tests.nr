#[test]
fn id_google_16() {
    let raw: [u8; 31] = padded("1111111111111111111111111111111".as_bytes());
    check_id(raw, 31, table::ID_DECIMAL_GOOGLE);
    let (tag, tag_len) = tag_of(table::USER_ID_TAG_GOOGLE);
    assert(
        node_halves(tag, tag_len, raw, 31)
            == [0x8766b502d2d781157b79f671c56b17e6, 0x6b54a3f480f77a36d39061a8530c1666],
    );
    assert(
        fixed_node_halves(table::USER_ID_TAG_GOOGLE, raw, 31)
            == [0x8766b502d2d781157b79f671c56b17e6, 0x6b54a3f480f77a36d39061a8530c1666],
    );
}

#[test(should_fail_with = "id too long")]
fn id_google_17() {
    let raw: [u8; 31] = padded("1111111111111111111111111111111".as_bytes());
    check_id(raw, 32, table::ID_DECIMAL_GOOGLE);
}

#[test(should_fail_with = "id is empty")]
fn id_google_18() {
    let raw: [u8; 31] = padded("".as_bytes());
    check_id(raw, 0, table::ID_DECIMAL_GOOGLE);
}

#[test(should_fail_with = "id byte not allowed")]
fn id_google_19() {
    let raw: [u8; 31] = padded("a\"b".as_bytes());
    check_id(raw, 3, table::ID_DECIMAL_GOOGLE);
}

#[test(should_fail_with = "id byte not allowed")]
fn id_google_20() {
    // "a\\b"
    let raw: [u8; 31] = [
        0x61, 0x5c, 0x62, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00,
    ];
    check_id(raw, 3, table::ID_DECIMAL_GOOGLE);
}

#[test(should_fail_with = "id byte not allowed")]
fn id_google_21() {
    let raw: [u8; 31] = padded("a\tb".as_bytes());
    check_id(raw, 3, table::ID_DECIMAL_GOOGLE);
}
