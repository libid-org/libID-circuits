#[test]
fn id_x_0() {
    let raw: [u8; 20] = padded("2244994945".as_bytes());
    check_id(raw, 10, table::ID_DECIMAL_X);
    let (tag, tag_len) = tag_of(table::USER_ID_TAG_X);
    assert(
        node_halves(tag, tag_len, raw, 10)
            == [0x68291869976ffad2abf3e933ec9ab262, 0x3395ff8b3b9242e655e1da3ef43d4f94],
    );
    assert(
        fixed_node_halves(table::USER_ID_TAG_X, raw, 10)
            == [0x68291869976ffad2abf3e933ec9ab262, 0x3395ff8b3b9242e655e1da3ef43d4f94],
    );
}

